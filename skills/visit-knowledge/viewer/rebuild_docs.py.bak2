#!/usr/bin/env python3
"""重新生成 visit-docs HTML 备份

优先使用 generated 记录中存储的完整 photos_data，
不再依赖 gallery 数据库（照片路径可能丢失）。
"""

import sys
import json
import sqlite3
from pathlib import Path
from datetime import datetime

sys.path.insert(0, '/home/open/.openclaw/workspace/skills/visit-knowledge/viewer')

from doc_generator import generate_html_doc

VISIT_PENDING = Path("/home/open/.openclaw/workspace/memory/visit-pending.json")
GALLERY_DB = Path("/home/open/.openclaw/media/gallery.db")
PHOTOS_BASE = Path("/home/open/.openclaw/media/photos")


def get_photos_from_record(photos_data):
    """从 generated 记录中的 photos_data 验证并补充照片信息"""
    valid_photos = []
    
    for photo in photos_data:
        rel_path = photo.get('rel_path', '')
        if not rel_path:
            # 尝试从 path 推断 rel_path
            path = photo.get('path', '')
            for base in [PHOTOS_BASE, Path("/home/open/.openclaw/media/photos")]:
                try:
                    rel_path = str(Path(path).relative_to(base))
                    photo['rel_path'] = rel_path
                    break
                except:
                    pass
        
        if rel_path:
            valid_photos.append(photo)
    
    return valid_photos


def get_photos_by_tag_from_db(tag_name):
    """从 gallery 数据库查询照片（备用方案：数据库有数据但 generated 没存完整信息时使用）"""
    photos = []
    
    try:
        conn = sqlite3.connect(str(GALLERY_DB))
        conn.row_factory = sqlite3.Row
        cur = conn.cursor()
        
        # photo_tags.photo_id 存无 .jpg 后缀的 UUID，photos.id 存带 .jpg 后缀的完整文件名
        cur.execute('''
            SELECT p.id, p.filepath, p.date, p.source, p.ai_desc
            FROM photo_tags pt
            JOIN tags t ON pt.tag_id = t.id
            LEFT JOIN photos p ON p.id = pt.photo_id || ".jpg"
            WHERE t.name = ?
            ORDER BY p.date DESC
        ''', (tag_name,))
        
        rows = cur.fetchall()
        conn.close()
        
        for row in rows:
            if row['filepath'] is None:
                continue
                
            photo_id = row['id']
            filepath = row['filepath']
            date = row['date'] or ''
            db_source = row['source'] or '未知'
            ai_desc = row['ai_desc'] or ''
            
            # 尝试从 .meta 文件获取更多信息
            meta_path = Path(filepath + ".meta")
            if meta_path.exists():
                try:
                    with open(meta_path, 'r', encoding='utf-8') as f:
                        meta = json.load(f)
                    if not ai_desc:
                        ai_desc = meta.get('ai_desc', '')
                    if db_source == '未知' or not db_source:
                        db_source = meta.get('source', '未知')
                except:
                    pass
            
            # 构建相对路径
            try:
                rel_path = str(Path(filepath).relative_to(PHOTOS_BASE))
            except:
                rel_path = Path(filepath).name
            
            photos.append({
                'id': photo_id,
                'path': filepath,
                'rel_path': rel_path,
                'desc': ai_desc or f'{tag_name}相关照片',
                'source': db_source,
                'date': date
            })
            
    except Exception as e:
        print(f"  数据库查询失败: {e}")
    
    return photos


def get_background_for_tag(tag_name):
    """获取标签的背景资料"""
    backgrounds = {
        '永昌陵': """<p><strong>永昌陵</strong>是北宋开国皇帝宋太祖赵匡胤的陵墓，位于河南省巩义市。</p>
<p>赵匡胤（927-976），发动陈桥兵变建立北宋，统一中国。永昌陵是北宋皇陵中规模最大的之一，体现了宋代皇家陵寝制度的特点。</p>
<p>陵墓神道两侧的石刻造像群是宋代石刻艺术的杰出代表，包括石象、石马、文臣、武将等，雕刻精美，神态各异。</p>""",
        
        '永昭陵': """<p><strong>永昭陵</strong>是北宋第四位皇帝宋仁宗赵祯的陵墓，位于河南省巩义市。</p>
<p>宋仁宗（1010-1063），在位42年，是宋代在位时间最长的皇帝之一。永昭陵整体布局保存较为完整，是研究北宋帝陵制度的重要遗址。</p>
<p>神道石刻造型优美，展现了北宋中期石刻艺术的成熟风格。</p>""",
        
        '大河村遗址': """<p><strong>大河村遗址</strong>是河南省郑州市的一处新石器时代遗址，距今约5000-7000年。</p>
<p>该遗址是仰韶文化的典型代表，出土了大量珍贵的彩陶制品，反映了中原地区原始农耕文明的高度发展。</p>
<p>遗址保留了完整的房屋基址、窖穴、陶窑等遗迹，为研究中原地区史前社会结构提供了重要资料。</p>""",
    }
    
    return backgrounds.get(tag_name, f"<p>关于{tag_name}的背景资料。</p>")


# 读取 pending
with open(VISIT_PENDING) as f:
    data = json.load(f)

generated = data.get('generated', [])
print(f"找到 {len(generated)} 个已生成的文档")

for doc in generated:
    tag = doc.get('tag', '')
    feishu_url = doc.get('feishu_doc_url', '')
    photos_data = doc.get('photos_data', [])
    
    if not tag:
        continue
    
    print(f"\n处理: {tag}")
    print(f"  飞书URL: {feishu_url}")
    
    # 优先使用 generated 记录中的 photos_data
    if photos_data:
        valid_photos = get_photos_from_record(photos_data)
        print(f"  使用 generated 记录中的 photos_data: {len(valid_photos)} 张")
    else:
        # 备用：从数据库查询
        print(f"  generated 记录中无 photos_data，尝试从数据库查询...")
        valid_photos = get_photos_by_tag_from_db(tag)
        print(f"  数据库查询到: {len(valid_photos)} 张")
    
    for p in valid_photos:
        desc = p.get('desc', '')[:40]
        print(f"    - {p.get('rel_path', 'unknown')}: {desc}...")
    
    # 使用 stored background_info 或生成占位
    background_info = doc.get('background_info', '')
    if not background_info:
        background_info = get_background_for_tag(tag)
        print(f"  背景资料: 使用占位（无 stored background_info）")
    else:
        print(f"  背景资料: 已存储")
    
    # 生成文档
    result = generate_html_doc(
        tag=tag,
        photos_data=valid_photos,
        background_info=background_info,
        feishu_doc_url=feishu_url
    )
    print(f"  已生成: {result}")

print("\n完成!")
