      "era": "北宋·太平兴国三年",
      "lines": [
        "宋太祖赵匡胤的陵墓",
        "位于河南巩义",
        "陵前石刻仪仗尚存"
      ],
      "note": "北宋皇陵的起点"
    },
    "fallback_pool": [
      {
        "title": "永昌陵",
        "era": "北宋·太平兴国三年",
        "lines": [
          "宋太祖赵匡胤的陵墓",
          "位于河南巩义",
          "陵前石刻仪仗尚存"
        ],
        "note": "北宋皇陵的起点"
      },
      {
        "title": "永昭陵",
        "era": "北宋·至道元年",
        "lines": [
          "宋太宗赵光义的陵墓",
          "与永昌陵相距不远",
          "两陵同在巩义境内"
        ],
        "note": "北宋相邻二陵"
      },
      {
        "title": "永裕陵",
        "era": "北宋·大中祥符四年",
        "lines": [
          "宋真宗赵恒的陵墓",
          "位于河南登封",
          "陵前石鸱鸟犹存"
        ],
        "note": "镇墓石鸱鸟"
      },
      {
        "title": "永泰陵",
        "era": "北宋·景祐二年",
        "lines": [
          "宋仁宗赵祯的陵墓",
          "位于河南洛阳伊川",
          "北宋中期皇陵之一"
        ],
        "note": "中期皇陵"
      },
      {
        "title": "五大名窑",
        "era": "南宋",
        "lines": [
          "汝官哥钧定并称",
          "一时窑火名天下",
          "传世皆为国之瑰宝"
        ],
        "note": "南宋人语"
      },
      {
        "title": "汝窑",
        "era": "北宋",
        "lines": [
          "河南宝丰清凉寺烧造",
          "天青釉素面无纹",
          "传世者屈指可数"
        ],
        "note": "宋瓷之极"
      },
      {
        "title": "官窑",
        "era": "南宋",
        "lines": [
          "杭州南宋官窑",
          "粉青釉紫口铁足",
          "传世以碗盘为多"
        ],
        "note": "宫廷御用"
      },
      {
        "title": "哥窑",
        "era": "南宋",
        "lines": [
          "开片如金丝铁线",
          "釉面缺陷反成绝景",
          "是缺陷也是美学"
        ],
        "note": "哥窑之辨"
      },
      {
        "title": "钧窑",
        "era": "北宋·金",
        "lines": [
          "河南禹州烧造",
          "窑变红紫号玫瑰紫",
          "蚯蚓走泥纹为其特征"
        ],
        "note": "窑变之奇"
      },
      {
        "title": "定窑",
        "era": "北宋",
        "lines": [
          "河北曲阳产白瓷",
          "刻花划花极精",
          "曾为贡品入宫廷"
        ],
        "note": "白瓷之极"
      },
      {
        "title": "建窑",
        "era": "南宋",
        "lines": [
          "福建建阳烧建盏",
          "兔毫油滴纹如星",
          "斗茶尚其黑釉白沫"
        ],
        "note": "茶事之器"
      },
      {
        "title": "磁州窑",
        "era": "北宋·金",
        "lines": [
          "河北磁州黑白绘",
          "花鸟人物皆入瓷",
          "磁州枕名动中原"
        ],
        "note": "民间瓷器"
      },
      {
        "title": "活字印刷",
        "era": "北宋·庆历年间",
        "lines": [
          "毕昇用胶泥刻字",
          "每字一印可拆复用",
          "载于《梦溪笔谈》"
        ],
        "note": "世界最早活字记载"
      },
      {
        "title": "磁针指南",
        "era": "北宋",
        "lines": [
          "沈括记方家磨针锋",
          "磁针指南为世最早",
          "载于《梦溪笔谈》"
        ],
        "note": "指南之祖"
      },
      {
        "title": "营造法式",
        "era": "北宋·崇宁二年",
        "lines": [
          "李诫编修颁行天下",
          "以材分八等制度",
          "后世营造多所本之"
        ],
        "note": "现存最早建筑专书"
      },
      {
        "title": "清明上河图",
        "era": "北宋",
        "lines": [
          "张择端绘汴河市井",
          "绢本长卷五米有余",
          "今藏故宫博物院"
        ],
        "note": "汴京生活全景"
      },
      {
        "title": "千里江山图",
        "era": "北宋·政和三年",
        "lines": [
          "王希孟十八岁作此",
          "青绿山水设色鲜丽",
          "今藏故宫博物院"
        ],
        "note": "青绿山水绝唱"
      },
      {
        "title": "东京梦华录",
        "era": "北宋末",
        "lines": [
          "孟元老追忆汴京",
          "记酒楼瓦舍百业",
          "为汴京留下证词"
        ],
        "note": "城市生活实录"
      },
      {
        "title": "瓦舍勾栏",
        "era": "南宋",
        "lines": [
          "城市中有瓦舍勾栏",
          "说书杂剧争相献艺",
          "市民娱乐成风气"
        ],
        "note": "市井之乐"
      },
      {
        "title": "交子",
        "era": "北宋",
        "lines": [
          "益州民间先用纸钱",
          "后由官设交子务",
          "是世界最早纸币"
        ],
        "note": "纸币之祖"
      },
      {
        "title": "建安龙团",
        "era": "北宋",
        "lines": [
          "建溪产团茶上贡",
          "碾末击拂成汤",
          "斗茶以色鲜白为胜"
        ],
        "note": "茶之为事"
      },
      {
        "title": "洗冤集录",
        "era": "南宋·淳祐七年",
        "lines": [
          "宋慈集验尸之法",
          "系统厘定检验程序",
          "是世界最早法医专书"
        ],
        "note": "法医之祖"
      },
      {
        "title": "武经总要",
        "era": "北宋·庆历年间",
        "lines": [
          "曾公亮丁度奉敕编撰",
          "载火砲阵法图谱",
          "兵书而兼绘画"
        ],
        "note": "宋代兵书"
      },
      {
        "title": "元日",
        "era": "北宋",
        "lines": [
          "爆竹声中一岁除",
          "春风送暖入屠苏",
          "王安石诗《元日》句"
        ],
        "note": "元日之景"
      },
      {
        "title": "梦溪笔谈",
        "era": "北宋",
        "lines": [
          "沈括晚年居梦溪园",
          "随笔记见三百余条",
          "天文地理医药皆载"
        ],
        "note": "博闻之书"
      },
      {
        "title": "寒食帖",
        "era": "北宋",
        "lines": [
          "苏轼号东坡居士",
          "黄州作《寒食帖》",
          "世称第三行书"
        ],
        "note": "书迹之宝"
      },
      {
        "title": "易安居士",
        "era": "南宋",
        "lines": [
          "李清照号易安居士",
          "与赵明诚共撰金石录",
          "南渡以后词风沉郁"
        ],
        "note": "千古第一女词人"
      }
    ]
  },
