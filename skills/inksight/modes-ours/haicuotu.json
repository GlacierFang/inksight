  "icon": "art",
  "cacheable": false,
  "description": "海错图：每日一则幻想海洋生物图鉴，画成四色卡通套色版画。水用留白表示，不填色。",
  "content": {
    "type": "computed",
    "provider": "haicuotu",
    "fallback": {
      "index_label": "第 1 则",
      "name": "墨尾鲛姥",
      "alias": "鲛婆",
      "size": "长三尺",
      "origin": "沉渊湾",
      "feature": "圆头无须，尾如墨条，跃起时拖一串水珠",
      "colophon": "潮退始见，捕之得盐",
      "credit": "",
      "art_url": "",
      "has_image": "no"
    }
  },
  "layout": {
    "status_bar": {
      "line_width": 1,
      "dashed": true
    },
    "body_align": "top",
    "body": [
      {
        "type": "conditional",
        "field": "has_image",
        "conditions": [
          {
            "op": "eq",
            "value": "yes",
            "children": [
