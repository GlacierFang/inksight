                "type": "image",
                "field": "art_url",
                "x": 0,
                "width": 400,
                "height": 234,
                "fit": "cover",
                "align_x": "center",
                "align_y": "center",
                "margin_bottom": 0
              }
            ]
          },
          {
            "op": "eq",
            "value": "no",
            "children": [
              {
                "type": "spacer",
                "height_px": 78
              },
              {
                "type": "text",
                "field": "name",
                "align": "center",
                "font": "noto_serif_bold",
                "font_size": 22,
                "max_lines": 1,
                "margin_bottom": 6
              },
              {
                "type": "text",
                "template": "{index_label} · {alias} · {size} · {origin}",
                "align": "center",
                "font": "noto_serif_light",
                "font_size": 12,
                "max_lines": 1,
                "margin_bottom": 10
              },
              {
                "type": "text",
                "field": "feature",
                "align": "center",
                "font": "noto_serif_light",
                "font_size": 14,
                "max_lines": 3,
                "margin_bottom": 8
              },
              {
                "type": "text",
                "field": "colophon",
                "align": "center",
                "font": "noto_serif_bold",
                "font_size": 14,
                "max_lines": 2,
                "margin_bottom": 0
              }
            ]
          }
        ]
      }
    ],
    "footer": {
      "label": "海错图",
      "attribution_template": "{colophon}",
      "dashed": true
    }
