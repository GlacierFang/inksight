{
  "mode_id": "CUSTOM_SONGMENG",
  "display_name": "大宋梦影",
  "icon": "art",
  "cacheable": false,
  "description": "大宋梦影：每天一则宋代市井梦景，画成四色卡通套色版画。梦影即虚构，不必对得上史实。",
  "content": {
    "type": "computed",
    "provider": "songmeng",
    "fallback": {
      "scene": "夜市",
      "colophon": "灯下有人把一盏盏灯笼点亮",
      "credit": "",
      "art_url": "",
      "has_image": "no"
    }
  },
  "layout": {
    "status_bar": {
      "line_width": 1,
      "dashed": true
    },
    "body_align": "top",
    "body": [
      {
        "type": "conditional",
        "field": "has_image",
        "conditions": [
          {
            "op": "eq",
            "value": "yes",
            "children": [
              {
                "type": "image",
                "field": "art_url",
                "x": 0,
                "width": 400,
                "height": 234,
                "fit": "cover",
                "align_x": "center",
                "align_y": "center",
                "margin_bottom": 0
              }
            ]
          },
          {
            "op": "eq",
            "value": "no",
            "children": [
              {
                "type": "spacer",
                "height_px": 93
              },
              {
                "type": "text",
                "field": "scene",
                "align": "center",
                "font": "noto_serif_bold",
                "font_size": 22,
                "max_lines": 1,
                "margin_bottom": 10
              },
              {
                "type": "text",
                "field": "colophon",
                "align": "center",
                "font": "noto_serif_light",
                "font_size": 14,
                "max_lines": 3,
                "margin_bottom": 0
              }
            ]
          }
        ]
      }
    ],
    "footer": {
      "label": "大宋梦影",
      "attribution_template": "{credit}",
      "dashed": true
    }
  },
