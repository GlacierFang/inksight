          },
          {
            "op": "eq",
            "value": "no",
            "children": [
              {
                "type": "spacer",
                "height_px": 90
              },
              {
                "type": "text",
                "template": "{name}在{home}",
                "align": "center",
                "font": "noto_serif_light",
                "font_size": 15,
                "max_lines": 1,
