<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>知识关联网络</title>
    <script src="https://d3js.org/d3.v7.min.js"></script>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { background: #0f0f0f; color: #fff; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; height: 100vh; display: flex; flex-direction: column; }
        header { padding: 16px 24px; border-bottom: 1px solid #222; display: flex; align-items: center; justify-content: space-between; flex-shrink: 0; }
        header h1 { font-size: 18px; font-weight: 600; }
        .back { color: #888; text-decoration: none; font-size: 14px; }
        .back:hover { color: #fff; }
        .main { flex: 1; display: flex; overflow: hidden; height: calc(100vh - 57px); }

        #graph { flex: 1; height: 100%; min-height: 0; display: block; }
        #sidebar { width: 280px; border-left: 1px solid #222; padding: 16px; overflow-y: auto; display: flex; flex-direction: column; gap: 12px; }

        .legend { display: flex; flex-direction: column; gap: 8px; }
        .legend-item { display: flex; align-items: center; gap: 8px; font-size: 13px; }
        .legend-dot { width: 12px; height: 12px; border-radius: 50%; flex-shrink: 0; }

        .stat { font-size: 12px; color: #666; }
        .stat strong { color: #fff; }

        .node-card { background: #1a1a1a; border-radius: 10px; padding: 12px; border: 1px solid #2a2a2a; }
        .node-card h3 { font-size: 14px; margin-bottom: 6px; }
        .node-card .meta { font-size: 11px; color: #888; display: flex; gap: 8px; flex-wrap: wrap; }
        .node-card .type-badge { padding: 2px 6px; border-radius: 4px; font-size: 10px; }
        .type-person { background: #1a3d5c; color: #5bc0de; }
        .type-event { background: #3d2e1a; color: #f39c12; }
        .type-concept { background: #2e1a3d; color: #9b59b6; }
        .node-card .books { font-size: 11px; color: #666; margin-top: 6px; }
        .node-card .connections { font-size: 12px; color: #888; margin-top: 6px; }
        .node-card .connections span { color: #5bc0de; cursor: pointer; }
        .node-card .connections span:hover { text-decoration: underline; }

        .filter-group { display: flex; flex-direction: column; gap: 6px; }
        .filter-label { font-size: 12px; color: #666; }
        .filter-btn { padding: 5px 10px; background: #1a1a1a; border: 1px solid #333; border-radius: 6px; color: #888; cursor: pointer; font-size: 12px; }
        .filter-btn:hover { border-color: #555; color: #fff; }
        .filter-btn.active { border-color: #07c160; color: #07c160; background: #0d2a1a; }

        .link { stroke: #333; stroke-opacity: 0.6; }
        .node circle { stroke: #fff; stroke-width: 1.5px; cursor: pointer; transition: stroke 0.2s; }
        .node circle:hover { stroke-width: 3px; }
        .node text { font-size: 10px; fill: #aaa; pointer-events: none; }
        .node.highlighted circle { stroke: #fff; stroke-width: 3px; }
        .dimmed { opacity: 0.15; }
    </style>
</head>
<body>
<header>
    <div style="display:flex; align-items:center; gap:16px;">
        <a href="/library/" class="back">← 电子书库</a>
        <h1>🕸️ 知识关联网络</h1>
    </div>
    <div style="font-size:12px; color:#666;">
        <span id="statNodes">-</span> 实体 · <span id="statEdges">-</span> 关联
    </div>
</header>

<div class="main">
    <div id="graph"></div>
    <div id="sidebar">
        <div class="legend">
            <div style="font-size:12px; color:#666; margin-bottom:4px;">类型</div>
            <div class="legend-item"><div class="legend-dot" style="background:#5bc0de;"></div>人物</div>
            <div class="legend-item"><div class="legend-dot" style="background:#f39c12;"></div>事件</div>
            <div class="legend-item"><div class="legend-dot" style="background:#9b59b6;"></div>概念</div>
        </div>

        <div class="filter-group">
            <div class="filter-label">筛选类型</div>
            <div style="display:flex; gap:6px; flex-wrap:wrap;">
                <button class="filter-btn active" data-type="all" onclick="setTypeFilter('all')">全部</button>
                <button class="filter-btn" data-type="person" onclick="setTypeFilter('person')">人物</button>
                <button class="filter-btn" data-type="event" onclick="setTypeFilter('event')">事件</button>
                <button class="filter-btn" data-type="concept" onclick="setTypeFilter('concept')">概念</button>
            </div>
        </div>

        <div class="filter-group">
            <div class="filter-label">筛选书籍</div>
            <select id="bookFilter" onchange="setBookFilter(this.value)" style="width:100%; background:#1a1a1a; border:1px solid #333; color:#fff; padding:6px 8px; border-radius:6px; font-size:12px;">
                <option value="all">全部书籍</option>
            </select>
        </div>

        <div class="filter-group">
            <div class="filter-label">显示数量</div>
            <div style="display:flex; gap:6px;">
                <button class="filter-btn" data-count="50" onclick="setCountFilter(50)">50</button>
                <button class="filter-btn active" data-count="200" onclick="setCountFilter(200)">200</button>
                <button class="filter-btn" data-count="500" onclick="setCountFilter(500)">500</button>
                <button class="filter-btn" data-count="all" onclick="setCountFilter(9999)">全部</button>
            </div>
        </div>

        <div id="detailPanel" style="display:none;">
            <div class="node-card">
                <h3 id="detailName">-</h3>
                <div class="meta">
                    <span id="detailType" class="type-badge">-</span>
                    <span id="detailBooks">-</span>
                </div>
                <div class="connections" id="detailConnections"></div>
            </div>
        </div>
    </div>
</div>

<script>
let network = { nodes: [], links: [] };
let typeFilter = 'all';
let bookFilter = 'all';
let countFilter = 200;
let simulation, svg, g;

const colors = { person: '#5bc0de', event: '#f39c12', concept: '#9b59b6' };

async function loadNetwork() {
    const res = await fetch('/library/api/network');
    if (!res.ok) { console.error('[DEBUG] HTTP错误:', res.status); return; }
    network = await res.json();
    console.log('[DEBUG] API返回: nodes=' + network.nodes.length + ', links=' + network.links.length + ', total_nodes=' + network.total_nodes);
    document.getElementById('statNodes').textContent = network.total_nodes;
    document.getElementById('statEdges').textContent = network.total_edges;

    // 填充书籍筛选
    const sel = document.getElementById('bookFilter');
    network.books.forEach(b => {
        const opt = document.createElement('option');
        opt.value = b;
        opt.textContent = b;
        sel.appendChild(opt);
    });

    console.log('[DEBUG] 调用renderGraph()');
    renderGraph();
    console.log('[DEBUG] renderGraph完成');
}

function setTypeFilter(t) {
    typeFilter = t;
    document.querySelectorAll('.filter-btn[data-type]').forEach(b => b.classList.remove('active'));
    document.querySelector(`.filter-btn[data-type="${t}"]`).classList.add('active');
    renderGraph();
}

function setBookFilter(v) {
    bookFilter = v;
    renderGraph();
}

function setCountFilter(n) {
    countFilter = n;
    document.querySelectorAll('.filter-btn[data-count]').forEach(b => b.classList.remove('active'));
    document.querySelector(`.filter-btn[data-count="${n}"]`).classList.add('active');
    renderGraph();
}

function renderGraph() {
    console.log('[DEBUG] renderGraph开始, typeFilter=' + window.typeFilter + ', bookFilter=' + window.bookFilter);
    // 过滤
    let nodes = network.nodes.filter(n => {
        if (typeFilter !== 'all' && n.type !== typeFilter) return false;
        if (bookFilter !== 'all' && !n.books.includes(bookFilter)) return false;
        return true;
    });
    nodes = nodes.sort((a,b) => b.count - a.count).slice(0, countFilter);

    const nodeIds = new Set(nodes.map(n => n.id));
    let links = network.links.filter(l => {
        const src = typeof l.source === 'object' ? l.source.id : l.source;
        const tgt = typeof l.target === 'object' ? l.target.id : l.target;
        return nodeIds.has(src) && nodeIds.has(tgt);
    });

    const container = document.getElementById('graph');
    container.innerHTML = '';

    requestAnimationFrame(() => {
        const rect = container.getBoundingClientRect();
        const w = Math.max(rect.width || 900);
        const h = Math.max(rect.height || 600);

        svg = d3.select('#graph').append('svg').attr('width', w).attr('height', h);
        svg.append('style').text('.node { cursor: pointer; }');

        const zoom = d3.zoom().scaleExtent([0.2, 5]).on('zoom', e => g.attr('transform', e.transform));
        svg.call(zoom);
        g = svg.append('g');

        // 连线
        const link = g.append('g').selectAll('line')
            .data(links).join('line')
            .attr('class', 'link')
            .attr('stroke-width', d => Math.min(d.weight, 5));

        // 节点
        const node = g.append('g').selectAll('g')
            .data(nodes).join('g')
            .attr('class', 'node')
            .call(d3.drag()
                .on('start', (e,d) => { if (!e.active) simulation.alphaTarget(0.3).restart(); d.fx = d.x; d.fy = d.y; })
                .on('drag', (e,d) => { d.fx = e.x; d.fy = e.y; })
                .on('end', (e,d) => { if (!e.active) simulation.alphaTarget(0); d.fx = null; d.fy = null; })
            )
            .on('click', (e, d) => showDetail(d));

        node.append('circle')
            .attr('r', d => Math.max(5, Math.min(20, Math.sqrt(d.count) * 3)))
            .attr('fill', d => colors[d.type] || '#888');

        node.append('text')
            .attr('dx', d => Math.max(5, Math.min(20, Math.sqrt(d.count) * 3)) + 4)
            .attr('dy', 4)
            .text(d => d.id.length > 10 ? d.id.slice(0,10) + '…' : d.id);

        simulation = d3.forceSimulation(nodes)
            .force('link', d3.forceLink(links).id(d => d.id).distance(60).strength(0.3))
            .force('charge', d3.forceManyBody().strength(-120))
            .force('center', d3.forceCenter(w/2, h/2))
            .force('collision', d3.forceCollide().radius(d => Math.max(10, Math.sqrt(d.count) * 3 + 5)))
            .on('tick', () => {
                link
                    .attr('x1', d => d.source.x).attr('y1', d => d.source.y)
                    .attr('x2', d => d.target.x).attr('y2', d => d.target.y);
                node.attr('transform', d => `translate(${d.x},${d.y})`);
            });
    });
}

function showDetail(d) {
    document.getElementById('detailPanel').style.display = 'block';
    document.getElementById('detailName').textContent = d.id;
    const typeEl = document.getElementById('detailType');
    typeEl.textContent = {person:'人物', event:'事件', concept:'概念'}[d.type] || d.type;
    typeEl.className = `type-badge type-${d.type}`;
    document.getElementById('detailBooks').textContent = d.books.join('、');
    document.getElementById('detailConnections').innerHTML = `出现在 <span>${d.count}</span> 个知识片段中`;
}

window.addEventListener('resize', () => renderGraph());
loadNetwork();
</script>
</body>
</html>
