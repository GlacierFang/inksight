<footer>个人工作台 · <span id="lastUpdate">-</span></footer>

<script>
// ── State ──
const SOURCE_COLORS = ['#07c160','#5bc0de','#f39c12','#9b59b6','#e74c3c','#3498db'];
let calData = {}; // day -> tasks
let calDaysInMonth = 30;

// ── Tab switching ──
function switchTab(tab) {
    ['overview','usage','sessions'].forEach(t => {
        document.getElementById('page-' + t).style.display = t === tab ? 'block' : 'none';
        document.getElementById('tab-' + t).classList.toggle('active', t === tab);
    });
    if (tab === 'overview') loadOverview();
    else if (tab === 'usage') loadUsage();
    else if (tab === 'sessions') loadSessions();
}

// ── API helper ──
async function api(url) {
    const r = await fetch(url);
    return r.json();
}

// ═══════════════════════════════════════
// OVERVIEW TAB
// ═══════════════════════════════════════
async function loadOverview() {
    await Promise.all([loadStats(), loadPublish(), loadAnalysis(), loadMemory(), loadQuickLinks(), loadCronTasks(), loadHeartbeat(), loadWorkData()]);
    loadCalendarOverview();
    document.getElementById('lastUpdate').textContent = new Date().toLocaleTimeString('zh-CN');
}

async function loadStats() {
    try {
        const d = await api('/dashboard/api/current-status');
        // 本时段内模型调用量
        document.getElementById('statWindowUsed').textContent = d.used || 0;
        // token 消耗加到 sub 里
        const tokens = d.window_total_tokens || 0;
        document.getElementById('statWindowKey').textContent = '窗口 ' + (d.window_key || '-') + ' | Token ' + tokens.toLocaleString();

        // 本时段内剩余调用量
        const remain = d.remaining || 0;
        const pct = Math.round(remain / 600 * 100);
        const remainEl = document.getElementById('statWindowRemain');
        remainEl.textContent = remain;
        remainEl.className = 'stat-value ' + (pct > 50 ? 'green' : pct > 20 ? 'amber' : 'red');

        // 当前会话数
        document.getElementById('statActiveSessions').textContent = d.active_in_window || 0;
        document.getElementById('statSessionDetail').textContent = '总会话 ' + (d.total_sessions || 0) + ' / 定时任务 ' + (d.cron_job_count || 0);

        // 当前状态模块
        document.getElementById('curActiveSessions').textContent = d.active_in_window || 0;
        document.getElementById('curCronTasks').textContent = d.cron_job_count || 0;
        document.getElementById('curActiveDialogs').textContent = d.active_dialogs || 0;
    } catch(e) { console.error(e); }
}

async function loadPublish() {
    try {
        const d = await api('/dashboard/api/publish?period=month');
        document.getElementById('pubCount').textContent = d.total || 0;
        document.getElementById('pubRate').textContent = '按时率 ' + (d.on_time_rate || 0) + '%';
        document.getElementById('pubCalendarRate').textContent = d.total ? (d.on_time_rate || 0) + '% 按时' : '';
    } catch(e) { console.error(e); }
}

async function loadAnalysis() {
    try {
        const d = await api('/dashboard/api/analysis');
        const el = document.getElementById('bookList');
        if (!d.books || d.books.length === 0) {
            el.innerHTML = '<div class="no-data">暂无正在分析的书</div>';
            return;
        }
        el.innerHTML = d.books.map(b => `
            <div class="book-item">
                <div class="book-header">
                    <span class="book-name">${escHtml(b.name)}</span>
                    <span class="book-pct">${b.progress}%</span>
                    ${b.source === 'queued' ? '<span class="cron-today">队列中</span>' : ''}
                </div>
                <div class="book-bar"><div class="book-fill" style="width:${b.progress}%"></div></div>
                <div class="book-meta">第 ${b.completed_chunks}/${b.total_chunks} 个卡片</div>
            </div>`).join('');
    } catch(e) { console.error(e); }
}

async function loadMemory() {
    try {
        const d = await api('/dashboard/api/memory');

        function renderFileList(files) {
            if (!files || files.length === 0) return '<div class="no-data">-</div>';
            return files.map(f => {
                const age = f.days_ago === 0 ? '今天' : f.days_ago === 1 ? '昨天' : f.days_ago + '天前';
                const ageClass = f.days_ago <= 1 ? 'badge-ok' : f.days_ago <= 3 ? 'badge-warn' : 'badge-error';
                return `<div class="memory-item">
                    <div class="memory-name">
                        <span class="memory-link" onclick="openMemoryViewer('${encodeURI(f.path)}')">${escHtml(f.name)}</span>
                        <div class="sub">${f.updated}</div>
                    </div>
                    <span class="cron-badge ${ageClass}">${age}</span>
                </div>`;
            }).join('');
        }

        document.getElementById('memoryProjects').innerHTML = renderFileList(d.projects);
        document.getElementById('memoryDaily').innerHTML = renderFileList(d.daily);
    } catch(e) { console.error(e); }
}

function openMemoryViewer(encodedPath) {
    document.getElementById('memoryViewer').style.display = '';
    document.getElementById('viewerContent').innerHTML = '<div class="loading">加载中…</div>';
    const path = decodeURIComponent(encodedPath);
    document.getElementById('viewerFileName').textContent = path.split('/').pop();
    fetch('/dashboard/api/memory/' + encodedPath)
        .then(r => r.ok ? r.text() : Promise.reject())
        .then(txt => {
            document.getElementById('viewerContent').innerHTML = '<pre class="viewer-pre">' + escHtml(txt) + '</pre>';
        })
        .catch(() => {
            document.getElementById('viewerContent').innerHTML = '<div class="no-data">加载失败</div>';
        });
}

function closeMemoryViewer() {
    document.getElementById('memoryViewer').style.display = 'none';
}

async function loadQuickLinks() {
    try {
        const d = await api('/dashboard/api/projects');
        document.getElementById('quickLinks').innerHTML = (d.projects || []).map(p =>
            `<a href="${p.url}" class="quick-link" target="_blank">${p.icon} ${escHtml(p.name)}</a>`
        ).join('');
    } catch(e) { console.error(e); }
}

async function loadCronTasks() {
    try {
        const d = await api('/dashboard/api/cron-runs');
        const el = document.getElementById('cronTaskList');
        if (!d.tasks || d.tasks.length === 0) { el.innerHTML = '<div class="no-data">暂无定时推送任务</div>'; return; }
        const statusBadge = {ok: 'badge-ok', warn: 'badge-warn', error: 'badge-error', idle: 'badge-idle'};
        const statusText = {ok: '✅', warn: '⚠️', error: '❌', idle: '⏳'};
        el.innerHTML = '<table class="cron-table"><thead><tr><th>任务</th><th>时间</th><th>渠道</th><th>状态</th></tr></thead><tbody>' +
            d.tasks.map(t => {
                const badge = statusBadge[t.status_type] || 'badge-idle';
                const icon = statusText[t.status_type] || '⏳';
                const today_tag = t.is_today ? ' <span class="cron-today">今日</span>' : '';
                return `<tr>
                    <td>${escHtml(t.name)}${today_tag}</td>
                    <td>${t.schedule}</td>
                    <td>${t.channel_icon} ${t.channel}</td>
                    <td><span class="cron-badge ${badge}">${icon} ${t.status}</span></td>
                </tr>`;
            }).join('') + '</tbody></table>';
    } catch(e) { console.error(e); }
}

async function loadHeartbeat() {
    try {
        const d = await api('/dashboard/api/heartbeat-status');
        const el = document.getElementById('hbList');
        const count = d.count || 0;
        document.getElementById('hbCount').textContent = count > 0 ? `今日 ${count} 次` : '';
        if (!d.heartbeats || d.heartbeats.length === 0) {
            el.innerHTML = '<div class="no-data">暂无心跳记录</div>';
            return;
        }
        el.innerHTML = d.heartbeats.map(t => `<span class="hb-dot">●</span><span class="hb-time">${t}</span>`).join('');
    } catch(e) { console.error(e); }
}

async function loadWorkData() {
    try {
        const d = await api('/dashboard/api/work-data');
        document.getElementById('wdSsdFree').textContent = d.ssd_free_gb + 'G';
        document.getElementById('wdSsdInfo').textContent = `已用 ${d.ssd_used_gb}G / ${d.ssd_total_gb}G`;
        document.getElementById('wdPhoto').textContent = d.photo_count || 0;
        document.getElementById('wdBookTotal').textContent = d.book_total || 0;
        document.getElementById('wdBookIndexed').textContent = d.book_indexed || 0;
    } catch(e) { console.error(e); }
}

// ═══════════════════════════════════════
// CALENDAR
// ═══════════════════════════════════════
let calYear, calMonth;

async function loadCalendarOverview() {
    const now = new Date();
    calYear = now.getFullYear();
    calMonth = now.getMonth() + 1;
    try {
        const d = await api(`/dashboard/api/publish/calendar?year=${calYear}&month=${calMonth}`);
        calDaysInMonth = d.days_in_month || 30;
        calData = {};
        (d.tasks || []).forEach(t => { if (!calData[t.day]) calData[t.day] = []; calData[t.day].push(t); });
        renderCalGrid('calGrid');
        renderCalGrid('calGrid2');
    } catch(e) { console.error(e); }
}

function renderCalGrid(gridId) {
    const grid = document.getElementById(gridId);
    if (!grid) return;
    grid.innerHTML = '';
    const firstDay = new Date(calYear, calMonth - 1, 1).getDay();
    const startOffset = firstDay === 0 ? 6 : firstDay - 1;
    const lastMonthDays = new Date(calYear, calMonth - 1, 0).getDate();
    const today = new Date();
    const todayDay = today.getDate();

    for (let i = startOffset - 1; i >= 0; i--) {
        grid.innerHTML += `<div class="cal-day other-month"><span class="day-num">${lastMonthDays - i}</span></div>`;
    }
    for (let day = 1; day <= calDaysInMonth; day++) {
        const tasks = calData[day] || [];
        const isToday = day === todayDay;
        let dots = '';
        if (tasks.length > 0) {
            const statuses = [...new Set(tasks.map(t => t.status))].slice(0, 3);
            dots = `<div class="dots">${statuses.map(s =>
                `<span class="dot dot-${s === 'success' ? 'success' : s === 'missed' ? 'missed' : 'pending'}"></span>`
            ).join('')}</div>`;
        }
        grid.innerHTML += `<div class="cal-day ${isToday ? 'today' : ''}" data-day="${day}" onclick="selectDay(${day})">
            <span class="day-num">${day}</span>${dots}</div>`;
    }
    const filled = startOffset + calDaysInMonth;
    for (let i = 1; i <= 42 - filled; i++) {
        grid.innerHTML += `<div class="cal-day other-month"><span class="day-num">${i}</span></div>`;
    }
}

function selectDay(day) {
    document.querySelectorAll('.cal-day').forEach(el => el.classList.remove('selected'));
    document.querySelectorAll(`.cal-day[data-day="${day}"]`).forEach(el => el.classList.add('selected'));
    document.getElementById('closeDetail').style.display = '';
    const tasks = calData[day] || [];
    document.getElementById('detailTitle').textContent = `${calYear}年${calMonth}月${day}日`;
    if (tasks.length === 0) {
        document.getElementById('detailBody').innerHTML = '<div class="day-empty">无发布任务</div>';
        return;
    }
    document.getElementById('detailBody').innerHTML = tasks.map(t => {
        const color = t.status === 'success' ? '#07c160' : t.status === 'missed' ? '#ef4444' : '#f59e0b';
        const statusText = t.status === 'success' ? '✓ 已发布' : t.status === 'missed' ? '✗ 漏发' : '○ 待发布';
        const time = t.timestamp ? new Date(t.timestamp).toLocaleTimeString('zh-CN', {hour:'2-digit', minute:'2-digit'}) : '-';
        const btn = t.status !== 'success'
            ? `<button class="mark-btn" onclick="markPub('${escHtml(t.account)}', ${day})">✓ 标记已发布</button>`
            : '';
        return `<div class="day-task">
            <span class="day-task-dot" style="background:${color}"></span>
            <span class="day-task-name">${escHtml(t.account)}</span>
            <span class="day-task-meta">${statusText} ${time}</span>
            ${btn}
        </div>`;
    }).join('');
}

async function markPub(account, day) {
    if (!confirm(`确认将「${account}」标记为已发布？`)) return;
    try {
        await fetch('/dashboard/api/publish/log', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ account, status: 'success', note: `手动标记 ${calYear}-${String(calMonth).padStart(2,'0')}-${String(day).padStart(2,'0')}` })
        });
        if (calData[day]) calData[day].forEach(t => { if (t.account === account) { t.status = 'success'; t.timestamp = new Date().toISOString(); }});
        selectDay(day);
    } catch(e) { alert('标记失败: ' + e.message); }
}

function closeDetail() {
    document.querySelectorAll('.cal-day').forEach(el => el.classList.remove('selected'));
    document.getElementById('detailTitle').textContent = '点击日期查看';
    document.getElementById('detailBody').innerHTML = '<div class="day-empty">点击左侧日历上的日期<br>查看当天发布任务并标记</div>';
    document.getElementById('closeDetail').style.display = 'none';
}

// ═══════════════════════════════════════
// USAGE TAB
// ═══════════════════════════════════════
async function loadUsage() {
    await Promise.all([loadUsageStats(), loadUsageBar(), loadUsageSys()]);
}

async function loadUsageStats() {
    try {
        const [d, dDaily, dSess, dWin] = await Promise.all([
            api('/dashboard/api/stats?period=month'),
            api('/dashboard/api/stats-daily'),
            api('/dashboard/api/sessions'),
            api('/dashboard/api/stats?period=day')
        ]);
        const remaining = 600 - (dWin.window_calls || 0);
        const pct = Math.round(remaining / 600 * 100);
        const winEl = document.getElementById('usageWindow');
        winEl.textContent = remaining + '/600';
        winEl.className = 'stat-value ' + (pct > 50 ? 'green' : pct > 20 ? 'amber' : 'red');

        document.getElementById('usageTotal').textContent = d.total_calls || 0;
        document.getElementById('usageRange').textContent = d.range ? d.range.start + ' 起' : '-';

        const days = (dDaily.daily || []).filter(dd => dd.total > 0).length || 1;
        document.getElementById('usageAvg').textContent = Math.round((d.total_calls || 0) / days);
        document.getElementById('usageTokens').textContent = remaining + '';
        document.getElementById('usageSessions').textContent = (dSess.sessions || []).filter(s => s.status === 'active').length;

        const sources = Object.entries(d.by_source || {});
        renderPieChart(sources);
        document.getElementById('sourceLegend').innerHTML = sources.map(([s, c], i) =>
            `<div class="source-item"><span class="source-dot" style="background:${SOURCE_COLORS[i%SOURCE_COLORS.length]}"></span>${escHtml(s)} (${c})</div>`
        ).join('');
    } catch(e) { console.error(e); }
}

function renderPieChart(data) {
    const el = document.getElementById('chartPie');
    el.innerHTML = '';
    if (!data || data.length === 0) { el.innerHTML = '<div class="no-data">暂无数据</div>'; return; }
    const w = el.clientWidth || 300, h = 200;
    const r = Math.min(w, h) / 2 - 25;
    const svg = d3.select(el).append('svg').attr('viewBox', `0 0 ${w} ${h}`);
    const g = svg.append('g').attr('transform', `translate(${w/2},${h/2})`);
    const pie = d3.pie().value(d => d[1]).sort(null);
    const arc = d3.arc().innerRadius(r * 0.55).outerRadius(r);
    const total = data.reduce((s, d) => s + d[1], 0);
    g.selectAll('path').data(pie(data)).join('path')
        .attr('d', arc).attr('fill', (d, i) => SOURCE_COLORS[i % SOURCE_COLORS.length]).attr('opacity', 0.9)
        .append('title').text(d => `${d.data[0]}: ${d.data[1]} (${(d.data[1]/total*100).toFixed(0)}%)`);
}

async function loadUsageBar() {
    try {
        const d = await api('/dashboard/api/stats-daily');
        renderBarChart(d.daily || []);
    } catch(e) { console.error(e); }
}

function renderBarChart(data) {
    const el = document.getElementById('chartBar');
    el.innerHTML = '';
    if (!data || data.length === 0) { el.innerHTML = '<div class="no-data">暂无数据</div>'; return; }
    const w = el.clientWidth || 400, h = 200;
    const m = { top: 10, right: 10, bottom: 30, left: 35 };
    const iw = w - m.left - m.right, ih = h - m.top - m.bottom;
    const svg = d3.select(el).append('svg').attr('viewBox', `0 0 ${w} ${h}`);
    const g = svg.append('g').attr('transform', `translate(${m.left},${m.top})`);
    const x = d3.scaleBand().domain(data.map(d => d.date.slice(5))).range([0, iw]).padding(0.2);
    const y = d3.scaleLinear().domain([0, d3.max(data, d => d.total) || 1]).nice().range([ih, 0]);
    g.append('g').call(d3.axisLeft(y).tickSize(-iw)).selectAll('line').attr('stroke', '#f1f3f5');
    g.select('.domain').remove();
    g.selectAll('rect').data(data).join('rect')
        .attr('x', d => x(d.date.slice(5))).attr('y', d => y(d.total))
        .attr('width', x.bandwidth()).attr('height', d => ih - y(d.total))
        .attr('fill', '#07c160').attr('rx', 3)
        .append('title').text(d => `${d.date}: ${d.total}次`);
    const xa = g.append('g').attr('transform', `translate(0,${ih})`).call(d3.axisBottom(x).tickValues(data.filter((_, i) => i % 5 === 0).map(d => d.date.slice(5))));
    xa.selectAll('text').attr('fill', '#8f959e').attr('font-size', '10px');
    xa.select('.domain').remove();
}

async function loadUsageSys() {
    try {
        const d = await api('/dashboard/api/system');
        const el = document.getElementById('sysList');
        el.innerHTML = (d.items || []).map(item => `
            <div class="sys-item">
                <span class="sys-name">${escHtml(item.name)}</span>
                <span class="sys-val ${item.status}">${item.status === 'ok' ? '✓ ' + item.message : item.message}</span>
            </div>`).join('');
    } catch(e) { console.error(e); }
}

// ═══════════════════════════════════════
// SESSIONS TAB
// ═══════════════════════════════════════
async function loadSessions() {
    try {
        const [dSess, dWin] = await Promise.all([
            api('/dashboard/api/sessions'),
            api('/dashboard/api/stats?period=day')
        ]);
        const sess = dSess.sessions || [];
        const active = sess.filter(s => s.status === 'active').length;
        const running = sess.filter(s => s.status === 'running').length;
        const idle = sess.length - active - running;
        document.getElementById('sessTotal').textContent = sess.length;
        document.getElementById('sessActive').textContent = active;
        document.getElementById('sessRunning').textContent = running;
        document.getElementById('sessIdle').textContent = idle;
        const remaining = 600 - (dWin.window_calls || 0);
        document.getElementById('sessWindow').textContent = remaining + '/600';

        const el = document.getElementById('sessionList');
        if (sess.length === 0) { el.innerHTML = '<div class="no-data">暂无会话</div>'; }
        else {
            el.innerHTML = sess.map(s => {
                const dot = s.status === 'active' ? 'dot-active' : s.status === 'running' ? 'dot-running' : 'dot-idle';
                const label = s.status === 'active' ? '工作中' : s.status === 'running' ? '执行中' : '空闲';
                return `<div class="session-item">
                    <span class="session-dot ${dot}"></span>
                    <span class="session-name">${escHtml(s.label || s.session_key || '未知')}</span>
                    <span class="session-meta">${label} · ${s.last_active || '-'}</span>
                </div>`;
            }).join('');
        }
    } catch(e) { console.error(e); }
}

// ── Util ──
function escHtml(s) {
    if (!s) return '';
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

// ── Init ──
loadOverview();
setInterval(() => {
    const activeTab = document.querySelector('.page-tab.active');
    if (activeTab && activeTab.id === 'tab-overview') loadOverview();
}, 60000);
</script>

