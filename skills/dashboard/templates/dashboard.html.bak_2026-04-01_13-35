                <div class="stat-value" style="color:#8f959e" id="sessIdle">-</div>
                <div class="stat-sub">无活动</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">订阅窗口</div>
                <div class="stat-value green" id="sessWindow">-</div>
