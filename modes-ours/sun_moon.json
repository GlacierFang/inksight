{
  "mode_id": "CUSTOM_SUN_MOON",
  "display_name": "日昼与月相",
  "icon": "weather",
  "cacheable": false,
  "description": "所选城市的当日日出、日落与白昼时长，入夜后换成当晚月相与月相图。数值取自 Open-Meteo，月相本地计算并绘图，一句话由模型当日现写。",
  "settings_schema": [
    {
      "key": "city",
      "label": "城市",
      "type": "location",
      "description": "留空则使用设备位置"
    }
  ],
  "content": {
    "type": "computed",
    "provider": "sun_moon",
    "fallback": {
      "period": "day",
      "city": "",
      "date_cn": "",
      "sunrise": "--:--",
      "sunset": "--:--",
      "daylight": "--",
      "delta": "",
      "moon_name": "",
      "moon_illum": "",
      "moon_age": "",
      "moon_to_full": "",
      "moon_to_new": "",
      "moon_image": "",
      "line": "",
      "source": "Open-Meteo",
      "day_arc": ""
    }
  },
  "layout": {
    "status_bar": {
      "line_width": 1,
      "dashed": true
    },
    "body": [
      {
        "type": "conditional",
        "field": "period",
        "conditions": [
          {
            "op": "eq",
            "value": "day",
            "children": [
              {
                "type": "two_column",
                "left_width": 192,
                "gap": 16,
                "left": [
                  {
                    "type": "text",
                    "template": "日出 {sunrise}",
                    "align": "center",
                    "font_size": 15,
                    "color": "yellow",
                    "max_lines": 1
                  }
                ],
                "right": [
                  {
                    "type": "text",
                    "template": "日落 {sunset}",
                    "align": "center",
                    "font_size": 15,
                    "color": "red",
                    "max_lines": 1
                  }
                ]
              },
              {
                "type": "spacer",
                "height_px": 4
              },
              {
                "type": "image",
                "field": "day_arc",
                "width": 320,
                "height": 74,
                "fit": "contain",
                "margin_bottom": 4
              },
              {
                "type": "spacer",
                "height_px": 2
              },
              {
                "type": "text",
                "template": "白昼时长 {daylight}",
                "align": "center",
                "font": "noto_serif_bold",
                "font_size": 17,
                "max_lines": 1
              },
              {
                "type": "spacer",
                "height_px": 2
              },
              {
                "type": "text",
                "field": "delta",
                "align": "center",
                "font_size": 11,
                "max_lines": 1
              },
              {
                "type": "spacer",
                "height_px": 4
              },
              {
                "type": "separator",
                "style": "short",
                "width": 64
              },
              {
                "type": "spacer",
                "height_px": 4
              },
              {
                "type": "text",
                "field": "line",
                "align": "center",
                "font": "noto_serif_light",
                "font_size": 13,
                "max_lines": 2
              }
            ]
          },
          {
            "op": "eq",
            "value": "night",
            "children": [
              {
                "type": "image",
                "field": "moon_image",
                "width": 104,
                "height": 104,
                "fit": "contain",
                "margin_bottom": 2
              },
              {
                "type": "text",
                "template": "{moon_name}",
                "align": "center",
                "font": "noto_serif_bold",
                "font_size": 18,
                "color": "yellow",
                "max_lines": 1
              },
              {
                "type": "spacer",
                "height_px": 2
              },
              {
                "type": "text",
                "template": "照亮 {moon_illum}",
                "align": "center",
                "font_size": 12,
                "max_lines": 1
              },
              {
                "type": "spacer",
                "height_px": 1
              },
              {
                "type": "text",
                "template": "月龄 {moon_age} · {moon_to_full}",
                "align": "center",
                "font_size": 11,
                "max_lines": 1
              },
              {
                "type": "spacer",
                "height_px": 5
              },
              {
                "type": "separator",
                "style": "short",
                "width": 64
              },
              {
                "type": "spacer",
                "height_px": 4
              },
              {
                "type": "text",
                "field": "line",
                "align": "center",
                "font": "noto_serif_light",
                "font_size": 13,
                "max_lines": 2
              }
            ]
          }
        ]
      }
    ],
    "footer": {
      "label": "日昼与月相",
      "attribution_template": "{city} {date_cn}",
      "dashed": true
    }
  }
}
