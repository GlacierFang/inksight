[Unit]
Description=OpenClaw AI Tagger - 为照片生成 AI 标签
After=network.target

[Service]
Type=oneshot
EnvironmentFile=/home/open/.openclaw/workspace/skills/gallery/ai_tagger.env
ExecStart=/usr/bin/python3 /home/open/.openclaw/workspace/skills/gallery/ai_tagger_safe.py
User=open
StandardOutput=journal
StandardError=journal

# 安全限制
MemoryMax=300M
CPUQuota=50%
TimeoutSec=120

[Install]
WantedBy=multi-user.target
