[Unit]
Description=OpenClaw Library Server
After=network.target

[Service]
Type=simple
User=open
WorkingDirectory=/home/open/.openclaw/workspace/skills/library
ExecStart=/usr/bin/python3 /home/open/.openclaw/workspace/skills/library/app.py
Restart=always
RestartSec=5

# 日志
StandardOutput=append:/home/open/.openclaw/logs/library.log
StandardError=append:/home/open/.openclaw/logs/library.log

[Install]
WantedBy=multi-user.target
