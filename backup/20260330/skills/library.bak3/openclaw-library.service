[Unit]
Description=OpenClaw Library Service
After=network.target

[Service]
Type=simple
User=open
WorkingDirectory=/home/open/.openclaw/workspace/skills/library
ExecStart=/usr/bin/python3 /home/open/.openclaw/workspace/skills/library/app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
